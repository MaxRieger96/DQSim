#!/usr/bin/env bash
set -euo pipefail

CLANG_FORMAT=$(command -v clang-format-19 || command -v clang-format) || {
  echo "need clang-format"
  exit 1
}

files=()
while IFS= read -r file; do
  if ! cmp -s <(git show :"$file") <(git show :"$file" | "$CLANG_FORMAT" -assume-filename="$file"); then
    files+=("$file")
  fi
done < <(
  git diff --cached --name-only --diff-filter=ACMRT |
    grep -E '\.(cpp|hpp|cc|hh|cxx|hxx|c|h)$' |
    grep -v -E '^src/thirdparty/' || true
)

if [[ ${#files[@]} -ne 0 ]]; then
  root=$(git rev-parse --show-toplevel)
  echo "Format errors, please run:"
  printf "%q -i" "$CLANG_FORMAT"
  printf " %q" "${files[@]/#/$root/}"
  echo
  exit 1
fi
